# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# Unused starter files kept only in the local workspace
/app/
/build/
/db/
/drizzle/
/examples/
/worker/
/.openai/
/drizzle.config.ts
/eslint.config.mjs
/next-env.d.ts
/next.config.ts
/package-lock.json
/postcss.config.mjs
/tsconfig.json
/vite.config.ts

# Source references and large originals; the site uses optimized derivatives
/public/file.svg
/public/globe.svg
/public/window.svg
/public/images/brand/
/public/images/portrait/svetlana-hero.png
/public/images/portrait/svetlana-original.jpg
/public/images/portrait/svetlana-original.webp
